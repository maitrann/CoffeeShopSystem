@{
    ViewBag.Title = "Blogs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<WebAPI_CoffeeShop.Models.ModelView.BlogView> lstBlog = ViewBag.lstBlog;
    var hasBlogs = lstBlog != null && lstBlog.Any();
}

<main>
    <!-- breadcrumb area start -->
    <section class="breadcrumb-area pt-140 pb-140 bg_img" data-background="~/Content/assets/images/bg/breadcrumb-bg-1.jpg" data-overlay="dark" data-opacity="5">
        <div class="shape shape__1"><img src="~/Content/assets/images/shape/breadcrumb-shape-1.png" alt=""></div>
        <div class="shape shape__2"><img src="~/Content/assets/images/shape/breadcrumb-shape-2.png" alt=""></div>
        <div class="container">
            <div class="row">
                <div class="col-xl-12 text-center">
                    <h2 class="page-title">Cafena Blog</h2>
                    <div class="cafena-breadcrumb breadcrumbs">
                        <ul class="list-unstyled d-flex align-items-center justify-content-center">
                            <li class="cafenabcrumb-item duxinbcrumb-begin">
                                <a href="/"><span>Home</span></a>
                            </li>
                            <li class="cafenabcrumb-item duxinbcrumb-end">
                                <span>Blogs</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- breadcrumb area end -->
    <!-- blog area start -->
    <div class="blog-area pt-120 pb-105">
        <div class="container">
            @if (!hasBlogs)
            {
                <div class="row">
                    <div class="col-xl-12 text-center">
                        <h3 class="mb-20">No blog posts yet</h3>
                        <p class="mb-30">Publish or seed a blog post and it will appear here.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-xl-8 col-lg-8">
                        <div class="blog__wrapper mt-none-30">
                            @foreach (var item in lstBlog)
                            {
                                var description = item.description ?? "";
                                if (description.Length > 220)
                                {
                                    description = description.Substring(0, 220) + "...";
                                }

                                <article class="blog__post format format-image mt-30">
                                    <div class="thumb">
                                        <img src="@item.image" alt="@item.title">
                                    </div>
                                    <ul class="meta mt-20 list-unstyled d-flex align-items-center">
                                        <li><span><i class="fal fa-comments"></i> @item.countCmt Comments</span></li>
                                        <li><span><i class="fal fa-calendar-alt"></i> @item.createDate</span></li>
                                    </ul>
                                    <div class="content mt-10">
                                        <h2 class="title border-effect mb-10"><a href="/Blogs/Details?id=@item.id">@item.title</a></h2>
                                        <p>@description</p>
                                    </div>
                                    <div class="bottom mt-35 d-flex align-items-center">
                                        <a href="/Blogs/Details?id=@item.id" class="site-btn">read more</a>
                                        <div class="author d-flex align-items-center">
                                            <h5 class="border-effect"><span style="font-size:15px;color:black">Written by: </span>@item.titleUserCreate</h5>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4">
                        <div class="blog__sidebar mt-none-30">
                            <div class="widget mt-30">
                                <h2 class="title">Recent Posts</h2>
                                <div class="recent-posts">
                                    @foreach (var item in lstBlog.Take(4))
                                    {
                                        <div class="item d-flex align-items-center">
                                            <div class="thumb">
                                                <img src="@item.image" alt="@item.title">
                                            </div>
                                            <div class="content">
                                                <h5 class="rp-title border-effect"><a href="/Blogs/Details?id=@item.id">@item.title</a></h5>
                                                <span class="date"><i class="fal fa-calendar-alt"></i> @item.createDate</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <!-- blog area end -->
</main>
